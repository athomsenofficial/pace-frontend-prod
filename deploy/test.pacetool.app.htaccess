# SPA routing for test.pacetool.app: serve index.html for client-side routes
# (/initial-mel, /final-mel, ...) so deep links and refreshes don't 404.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
